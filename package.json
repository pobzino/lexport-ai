{
  "name": "lexport",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@lexport/web",
    "dev:mobile": "turbo dev --filter=@lexport/mobile",
    "build": "turbo build",
    "build:web": "turbo build --filter=@lexport/web",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "packageManager": "bun@1.3.9",
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@supabase/supabase-js": "^2.114.0",
    "@types/node": "^22.20.1",
    "next": "^16.3.4",
    "pdf-parse": "1.1.1"
  }
}
