# ── E2E money-path test config ──────────────────────────────────────────────
# Copy to .env.e2e and fill in. Used to run the FULL authenticated suite
# (signup → generate → edit → send → sign → pay → invoice) safely.
#
# Run against LOCAL dev (bun run dev, port 3500) — NOT production.
PLAYWRIGHT_BASE_URL=http://localhost:3500

# Seeded test account (created by scripts/seed-e2e-user.ts). global-setup logs
# in with these to produce the authenticated storage state.
E2E_LOGIN_EMAIL=e2e-user@example.com
E2E_LOGIN_PASSWORD=replace-with-a-unique-test-password

# ── Stripe TEST mode (YOU must paste these from dashboard.stripe.com in TEST mode) ──
# Without these, the payment/billing tests will hit LIVE Stripe — do not run
# them until these are real test-mode values.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_PRO_PRICE_ID=price_test_REPLACE_ME
STRIPE_TEAM_PRICE_ID=price_test_REPLACE_ME
# Stripe test card for the signing/payment flow: 4242 4242 4242 4242, any future date/CVC.
